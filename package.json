{
  "name": "@ses-receiving/email-client",
  "version": "1.0.0",
  "description": "Client library for reading emails from AWS SES S3 bucket, similar to MailSlurp API",
  "packageManager": "pnpm@10.14.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run src",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "aws",
    "ses",
    "s3",
    "email",
    "testing",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "mailparser": "^3.7.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ]
}
